{
  "name": "jauni-deck-beta",
  "version": "0.4.1",
  "private": true,
  "description": "Phone/tablet controller for Windows and macOS",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node --test",
    "build:windows": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg zip"
  },
  "engines": { "node": ">=18" },
  "devDependencies": { "electron": "^38.0.0", "electron-builder": "^26.0.12" },
  "dependencies": { "electron-updater": "^6.6.2" },
  "build": {
    "appId": "kr.co.jaunistudio.jaunideck",
    "productName": "JauniDeck",
    "files": ["electron-main.js", "server.js", "public/**/*", "package.json"],
    "asar": true,
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.utilities" }
  }
}
